# Environment Variables Template
# Copy this file to .env and fill in your values

# ==============================================================================
# 1. PRIMARY LLM PROVIDERS (Groq & NVIDIA NIM)
# ==============================================================================
# Groq (Ultra-Fast 500+ tokens/sec)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (Enterprise Deep Reasoning)
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# Gemini (Optional Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. PAPERCLIP SWARM ORCHESTRATION
# ==============================================================================
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
PAPERCLIP_COMPANY_ID=fc52c515-6c63-4f40-b5f8-2496ffd76e79

# ==============================================================================
# 3. NOTIFICATION & OUTBOUND CHANNELS (Optional)
# ==============================================================================
# Telegram Delivery (for hot lead alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Delivery (SMTP)
EMAIL_SENDER=your_email_address_here
EMAIL_PASSWORD=your_email_app_password_here
EMAIL_RECEIVER=receiver_email_address_here

# WhatsApp Delivery (Twilio - Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=your_twilio_whatsapp_number_here
WHATSAPP_NUMBER=receiver_whatsapp_number_here

# Google Places API (Optional - default scraper runs without API key)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
