# Environment Variables Template
# Copy this file to .env and fill in the values

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
# LLM_PROVIDER=gemini # default

# Telegram Delivery
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Delivery (SMTP)
EMAIL_SENDER=your_email_address_here
EMAIL_PASSWORD=your_email_app_password_here
EMAIL_RECEIVER=receiver_email_address_here

# WhatsApp Delivery (Twilio) - Optional
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=your_twilio_whatsapp_number_here
WHATSAPP_NUMBER=receiver_whatsapp_number_here

# Outbound Pipeline - Optional
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
